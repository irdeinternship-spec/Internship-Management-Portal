{
  "name": "student-registration-backend",
  "version": "1.0.0",
  "description": "Express backend for the Student Registration Portal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node -e \"require('dotenv').config(); require('./services/postgresSchema').ensurePostgresSchema().then(() => require('./db').end())\"",
    "db:import-colleges": "node scripts/importColleges.js",
    "seed": "node scripts/seed.js",
    "smoke": "node scripts/smoke.js"
  },
  "keywords": [
    "express",
    "student-registration",
    "multer"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@sparticuz/chromium": "^143.0.4",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "googleapis": "^173.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "papaparse": "^5.5.4",
    "pg": "^8.23.0",
    "puppeteer-core": "^25.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
