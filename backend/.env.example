PORT=5000
NODE_ENV=development

JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=8h

DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# R2_ACCOUNT_ID is informational only - not read by the app; it's the value
# already baked into R2_ENDPOINT below. Kept so a new deploy knows which
# Cloudflare account/dashboard this bucket lives in.
R2_ACCOUNT_ID=your_r2_account_id
R2_ENDPOINT=https://your_r2_account_id.r2.cloudflarestorage.com
R2_BUCKET=your_r2_bucket_name
R2_REGION=auto
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

CORS_ORIGINS=http://localhost:5173

MAIN_ADMIN_EMAIL=your_main_admin_email
MAIN_ADMIN_NAME=Main Administrator
MAIN_ADMIN_INITIAL_PASSWORD=set_only_for_the_first_seed
ADMIN_SETUP_KEY=your_admin_setup_key
ENCRYPTION_KEY=your_encryption_key_hex_32_bytes

# Set to 'true' to enable live email delivery via Gmail OAuth2. When false (default), emails are skipped, logged to ActivityLog, and return success.
EMAIL_ENABLED=false
EMAIL_USER=your_gmail@gmail.com
MAIL_FROM=your_gmail@gmail.com

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# 'tunnel' (secure: true, sameSite: 'lax') or 'local' (secure: false, sameSite: 'lax')
DEPLOY_MODE=local
# FRONTEND_DIST_PATH=../web-portal/dist
# Local dev only: point at a real installed Chrome instead of @sparticuz/chromium's Linux-only binary
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# How long a PDF generation request waits in the concurrency-1 queue before failing
PDF_QUEUE_TIMEOUT_MS=45000
